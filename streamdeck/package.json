{
  "name": "meetingdebrief-streamdeck",
  "version": "0.1.0",
  "private": true,
  "description": "Stream Deck key that starts and stops MeetingDebrief recording",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w --watch.onEnd=\"streamdeck restart com.meetingdebrief.record\""
  },
  "dependencies": {
    "@elgato/streamdeck": "3.0.3"
  },
  "devDependencies": {
    "@elgato/cli": "1.10.3",
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^24.10.1",
    "rollup": "^4.53.3",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3"
  }
}
